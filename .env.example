# PyRIT OpenAIChatTarget 配置模板（复制为 .env 并填入真实值；.env 已被 .gitignore 排除，禁止提交）
# 变量说明：
#   OPENAI_CHAT_KEY       —— API 密钥
#   OPENAI_CHAT_ENDPOINT  —— API 基址（OpenAI 兼容网关）
#   OPENAI_CHAT_MODEL     —— 模型名
OPENAI_CHAT_KEY=<your-api-key>
OPENAI_CHAT_ENDPOINT=https://api.longcat.chat/openai
OPENAI_CHAT_MODEL=LongCat-2.5

# 评分模型（scorer / LLM judge）：与攻击/目标模型相互独立的命名空间，必须配置为不同模型
OPENAI_SCORER_KEY=<your-scorer-api-key>
OPENAI_SCORER_ENDPOINT=https://api.longcat.chat/openai
OPENAI_SCORER_MODEL=LongCat-2.5
